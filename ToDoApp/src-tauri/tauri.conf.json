{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FloTask",
  "version": "0.1.0",
  "identifier": "com.flotask.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FloTask — Focus · Flow · Finish",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: https://flotask-xi.vercel.app; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://flotask-xi.vercel.app; style-src 'self' 'unsafe-inline' https://flotask-xi.vercel.app; connect-src 'self' https://flotask-xi.vercel.app; img-src 'self' data: blob: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
